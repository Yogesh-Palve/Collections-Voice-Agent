# =============================================================================
# Collections Voice Agent — Environment Configuration
# Copy to .env and fill in values. Provider switches require no code changes.
# =============================================================================

# --- Provider selection ---
STT_PROVIDER=deepgram
# deepgram | elevenlabs | cartesia | hume

TTS_PROVIDER=elevenlabs
# elevenlabs | sarvam

LLM_PROVIDER=groq
# groq (primary)

# --- Speech-to-Text ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi

ELEVENLABS_API_KEY=

# Optional STT providers (set STT_PROVIDER to use)
CARTESIA_API_KEY=
HUME_API_KEY=

# --- Text-to-Speech ---
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

SARVAM_API_KEY=
SARVAM_SPEAKER=meera
SARVAM_LANGUAGE=hi-IN

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_EXTRACTION_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0.3

DATA_DIR=data/

# --- Twilio (telephonic interface) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL for webhooks (e.g. ngrok): https://your-host.example.com
TWILIO_WEBHOOK_BASE_URL=

# --- Application ---
COMPANY_NAME=ABC Finance Collections
AGENT_NAME=Priya
MAX_RESPONSE_LATENCY_MS=8000
MAX_CONTEXT_TURNS=10
LOG_DIR=logs/

# VAD / audio
VAD_AGGRESSIVENESS=2
VAD_FRAME_MS=30
SAMPLE_RATE=16000

# Cost estimation (USD per unit — adjust to your vendor pricing)
COST_PER_1K_PROMPT_TOKENS=0.00059
COST_PER_1K_COMPLETION_TOKENS=0.00079
COST_PER_TTS_CHARACTER=0.00003
COST_PER_STT_SECOND=0.0043

# Filler audio while LLM thinks (comma-separated short phrases)
FILLER_PHRASES=Hmm, ek second., Ji, sun rahi hoon., One moment please.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
